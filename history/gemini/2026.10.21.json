    {
        "title": "\"\uacf5\ubb34\uc6d0\ub3c4 AI \uc4f4\ub2e4\"\u2026\uad6c\uae00, \ubbf8 \uc5f0\ubc29\uc815\ubd80 \uc804\uc6a9 '\uc81c\ubbf8\ub098\uc774 \ud3ec \uac70\ubc84\uba3c\ud2b8' \uc804\uaca9 \ucd9c\uc2dc",
        "summary": "\uad6c\uae00 \ud37c\ube14\ub9ad\uc139\ud130\uac00 \ubbf8 \uc5f0\ubc29\uae30\uad00\uc744 \uc704\ud55c \uc5d0\uc774\uc804\ud2b8\ud615 AI '\uc81c\ubbf8\ub098\uc774 \ud3ec \uac70\ubc84\uba3c\ud2b8'\ub97c \ub0b4\ub1a8\uc5b4\uc694. \uc624\ud508AI\u00b7\uc564\ud2b8\ub85c\ud53d\ub3c4 \uc815\ubd80\uc6a9 \uc694\uae08\uc744 \uae4e\uc544\uc8fc\uba70 \uacbd\uc7c1 \uc911\uc778 \uc0c1\ud669\uc5d0\uc11c, \ud589\uc815\uc5c5\ubb34 \uc804\ubc18\uc5d0 AI\uac00 \ubcf8\uaca9\uc801\uc73c\ub85c \ub4e4\uc5b4\uac00\ub294 \uc2e0\ud638\ub85c \uc77d\ud600\uc694.",
        "tag": "NEW FEATURE",
